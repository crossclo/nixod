#!/usr/bin/env bash
# nixod: entry point. Each command is a short script in commands/, made of
# named steps. Read it to see what a command does, or to run a step by hand.
set -euo pipefail

libexec=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

usage() {
  cat <<'EOF'
Usage: nixod <command> [options]

  identity host <name>             create this host's identity (Syncthing, SSH key)
  identity hub <name>              create the hub's identity in a tmpfs staging dir
  probe <user@ip>                  describe a VPS's stock system (network, disks, boot)
  install-hub <name> <user@ip>     install NixOS on the hub with nixos-anywhere
  init-status [<name>]             where an interrupted init stands, and the next step

  join [<name>]                    new host: push its join request (branch + pull request)
  review <pr | branch>             trusted host: show and build a join request
  approve <pr | branch>            trusted host: merge it with a signed commit, push
  remove <name>                    trusted host: finish removing a machine

  check                            fetch and verify updates; notify (hosts)
  update                           verify, fast-forward and switch to the update (hosts)
  status                           running commit, last hub update, Syncthing peers
  trust-once <public key>          hub console only: accept one update signed by it
  update-hub                       the hub's automatic update (run by systemd)

  doc [<name>]                     the agent playbooks (no name: list them)
  starter [copy|diff <file>...]    ready-made config files to copy into the repo

Every command takes --help. identity, probe, install-hub, join, approve,
remove and update take --dry-run: print the steps and the exact commands, run nothing.
EOF
}

cmd=${1:-}
[[ $# -gt 0 ]] && shift
case $cmd in
identity | probe | install-hub | init-status | join | review | approve | remove | doc | starter | check | update | status | trust-once | update-hub) exec "$libexec/commands/$cmd.sh" "$@" ;;
"" | -h | --help | help) usage ;;
*)
  printf 'nixod: unknown command: %s\n\n' "$cmd" >&2
  usage >&2
  exit 2
  ;;
esac
