# i3 (X11) desktop, started by greetd. GNOME (Wayland) can stay available as
# a fallback session in the tuigreet menu shown after logging out.
#
# Self-contained: X server, i3, greetd, boot splash, fonts, keyring, polkit.
# The i3 config itself lives in the Home Manager profile (home/profiles/i3.nix).
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.nixod.profiles.desktop-i3;
  defaults = import ../../../lib/defaults.nix { inherit lib; };
  s = config.nixod.settings;
  user = s.user.name;

  # Starts Xorg, then the ~/.xsession generated by Home Manager
  # (xsession.enable). That script runs the whole session: imports
  # DISPLAY/XAUTHORITY into systemd --user, starts hm-graphical-session.target
  # (which pulls graphical-session.target and tray.target → picom/dunst),
  # runs i3, then stops the targets on exit. graphical-session.target has
  # RefuseManualStart=yes: it can't be started by hand, it MUST come from here.
  # Used both by initial_session (auto-login) and by the i3 entry of the
  # tuigreet menu: one start path, tested.
  boot-i3 = pkgs.writeShellScript "boot-i3" ''
    exec ${pkgs.xorg.xinit}/bin/startx /home/${user}/.xsession
  '';

  # Sessions offered by tuigreet:
  #   - GNOME (Wayland): links to the official sessions from the modules.
  #   - i3 (X11):        a .desktop pointing at boot-i3.
  sessionsBase = config.services.displayManager.sessionData.desktops;

  customSessions = pkgs.runCommand "custom-sessions" { } ''
    mkdir -p $out/share/wayland-sessions $out/share/xsessions

    if [ -d "${sessionsBase}/share/wayland-sessions" ]; then
      for f in ${sessionsBase}/share/wayland-sessions/*.desktop; do
        [ -e "$f" ] && ln -s "$f" "$out/share/wayland-sessions/$(basename "$f")"
      done
    fi

    cat > $out/share/xsessions/i3.desktop <<'EOF'
    [Desktop Entry]
    Name=i3
    Comment=Improved dynamic tiling window manager (via startx)
    Exec=${boot-i3}
    Type=Application
    EOF
  '';
in
{
  options.nixod.profiles.desktop-i3 = {
    enable = lib.mkEnableOption "the i3 desktop (X11, greetd, fonts)";

    autoLogin = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Start i3 at boot without a login screen. The tuigreet menu still
        shows after logging out.
      '';
    };

    gnomeFallback = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Offer a GNOME (Wayland) session in the tuigreet menu.";
    };
  };

  config = lib.mkIf cfg.enable (
    lib.mkMerge [
      # Additive: merges with the instance's own lists.
      {
        boot.kernelParams = [
          "quiet"
          "splash"
          "udev.log_priority=3"
          "rd.systemd.show_status=false"
        ];

        services.xserver.xkb.layout = lib.mkIf (s.keyboard.xkb != null) s.keyboard.xkb;

        services.xserver.windowManager.i3.extraPackages = with pkgs; [
          feh # wallpaper
        ];

        # PAM entry for i3lock (the i3 home profile uses i3lock-color).
        # Without it, unlocking refuses every password.
        security.pam.services.i3lock = { };

        xdg.portal.extraPortals = [ pkgs.xdg-desktop-portal-gtk ];

        fonts.packages = with pkgs; [
          nerd-fonts.jetbrains-mono
          inter
          noto-fonts
          noto-fonts-cjk-sans
          noto-fonts-color-emoji
        ];
      }

      (defaults {
        # -------- Boot splash --------
        boot.plymouth.enable = true;
        boot.consoleLogLevel = 0;
        boot.initrd.verbose = false;

        # -------- X server + i3 --------
        services.xserver = {
          enable = true;

          # Installs xinit + `startx` and exposes /etc/X11/xorg.conf.d.
          # Without it, startx fails silently ("cannot display").
          displayManager.startx.enable = true;

          windowManager.i3 = {
            enable = true;
            package = pkgs.i3;
          };
        };

        # -------- greetd: tuigreet menu (and optional auto-login) --------
        services.greetd = {
          enable = true;
          settings = {
            # After logout (or at boot without auto-login): tuigreet menu.
            # No --xsession-wrapper: each .desktop carries its full Exec.
            default_session = {
              command = builtins.concatStringsSep " " [
                "${pkgs.tuigreet}/bin/tuigreet"
                "--time"
                "--remember"
                "--remember-user-session"
                "--asterisks"
                "--sessions ${customSessions}/share/wayland-sessions:${customSessions}/share/xsessions"
              ];
              user = "greeter";
            };
          }
          // lib.optionalAttrs cfg.autoLogin {
            # At boot: start i3 directly, no login screen.
            initial_session = {
              command = "${boot-i3}";
              inherit user;
            };
          };
        };

        # -------- Desktop plumbing --------
        services.gnome.gnome-keyring.enable = true;

        # dconf: needed by the Home Manager GTK modules (theme, cursor).
        programs.dconf.enable = true;

        xdg.portal = {
          enable = true;
          config.common.default = "*";
        };

        hardware.graphics = {
          enable = true;
          enable32Bit = true;
        };

        environment.sessionVariables = {
          _JAVA_AWT_WM_NONREPARENTING = "1"; # Java apps under a tiling WM
        };

        # -------- Fonts --------
        fonts.fontconfig.defaultFonts = {
          sansSerif = [
            "Inter"
            "Noto Sans"
          ];
          serif = [ "Noto Serif" ];
          monospace = [ "JetBrainsMono Nerd Font" ];
          emoji = [ "Noto Color Emoji" ];
        };
      })

      # -------- GNOME fallback (Wayland) --------
      # GDM stays off: greetd is the display manager.
      (lib.mkIf cfg.gnomeFallback (
        lib.mkMerge [
          (defaults {
            services.desktopManager.gnome.enable = true;
            services.displayManager.gdm.enable = false;
          })
          {
            environment.gnome.excludePackages = with pkgs; [
              epiphany
              geary
              gnome-tour
              gnome-music
              gnome-maps
              gnome-contacts
            ];
          }
        ]
      ))
    ]
  );
}
