# X11 desktop plumbing, without a desktop of its own: the X server, greetd
# with a tuigreet menu, and what graphical apps expect (keyring, dconf,
# portals, GPU). The session it starts is the user's ~/.xsession, written by
# Home Manager (xsession.enable): the window manager, the bar, the theme and
# the fonts are the instance's own files (starter/ has an i3 set:
# home/i3.nix and system/desktop.nix).
{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.nixod.profiles.x11;
  defaults = import ../../../lib/defaults.nix { inherit lib; };
  s = config.nixod.settings;
  user = s.user.name;

  # Starts Xorg, then the ~/.xsession generated by Home Manager
  # (xsession.enable). That script runs the whole session: imports
  # DISPLAY/XAUTHORITY into systemd --user, starts hm-graphical-session.target
  # (which pulls graphical-session.target and tray.target), runs the window
  # manager, then stops the targets on exit. graphical-session.target has
  # RefuseManualStart=yes: it can't be started by hand, it MUST come from here.
  # Used both by initial_session (auto-login) and by the X session entry of
  # the tuigreet menu: one start path.
  boot-xsession = pkgs.writeShellScript "boot-xsession" ''
    exec ${pkgs.xinit}/bin/startx /home/${user}/.xsession
  '';

  # Display managers that would start next to greetd (typically ported from
  # the old /etc/nixos/configuration.nix).
  dm = config.services.displayManager;
  otherDisplayManagers = lib.filter (n: n != null) [
    (if dm.gdm.enable then "services.displayManager.gdm" else null)
    (if dm.sddm.enable then "services.displayManager.sddm" else null)
    (if dm.ly.enable then "services.displayManager.ly" else null)
    (
      if config.services.xserver.displayManager.lightdm.enable then
        "services.xserver.displayManager.lightdm"
      else
        null
    )
  ];

  # Sessions offered by tuigreet:
  #   - Wayland desktops the machine enables (GNOME, ...): links to their
  #     official sessions;
  #   - the user's ~/.xsession: a .desktop pointing at boot-xsession.
  sessionsBase = config.services.displayManager.sessionData.desktops;

  customSessions = pkgs.runCommand "custom-sessions" { } ''
    mkdir -p $out/share/wayland-sessions $out/share/xsessions

    if [ -d "${sessionsBase}/share/wayland-sessions" ]; then
      for f in ${sessionsBase}/share/wayland-sessions/*.desktop; do
        [ -e "$f" ] && ln -s "$f" "$out/share/wayland-sessions/$(basename "$f")"
      done
    fi

    cat > $out/share/xsessions/xsession.desktop <<'EOF'
    [Desktop Entry]
    Name=${cfg.sessionName}
    Comment=Your ~/.xsession (Home Manager), via startx
    Exec=${boot-xsession}
    Type=Application
    EOF
  '';
in
{
  imports = [
    (lib.mkRemovedOptionModule [ "nixod" "profiles" "desktop-i3" ] ''
      nixod no longer ships a desktop. Use nixod.profiles.x11 (X server,
      greetd, keyring, portals: the same start path), and put the i3 parts
      in the instance: `nixod starter copy system/desktop.nix home/i3.nix`
      (i3, the lock screen's PAM entry, fonts, boot splash, GNOME fallback).
      gnomeFallback is in system/desktop.nix now; autoLogin is
      nixod.profiles.x11.autoLogin.'')
  ];

  options.nixod.profiles.x11 = {
    enable = lib.mkEnableOption "the X11 desktop plumbing (X server, greetd, keyring, portals)";

    autoLogin = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Start the X session at boot without a login screen. The tuigreet
        menu still shows after logging out.
      '';
    };

    sessionName = lib.mkOption {
      type = lib.types.str;
      default = "X session";
      example = "i3";
      description = "Name of the ~/.xsession entry in the tuigreet menu.";
    };
  };

  config = lib.mkIf cfg.enable (
    lib.mkMerge [
      {
        assertions = [
          {
            assertion = otherDisplayManagers == [ ];
            message = ''
              nixod.profiles.x11 uses greetd as its display manager, but
              ${lib.concatStringsSep ", " otherDisplayManagers} is enabled too (ported from the old
              configuration?). Remove it, or turn x11 off to keep the old desktop.
            '';
          }
        ];
      }

      # Additive: merges with the instance's own lists.
      {
        services.xserver.xkb.layout = lib.mkIf (s.keyboard.xkb != null) s.keyboard.xkb;
        services.xserver.xkb.variant = lib.mkIf (s.keyboard.xkbVariant != "") s.keyboard.xkbVariant;

        xdg.portal.extraPortals = [ pkgs.xdg-desktop-portal-gtk ];
      }

      (defaults {
        # -------- X server --------
        services.xserver = {
          enable = true;

          # Installs xinit + `startx` and exposes /etc/X11/xorg.conf.d.
          # Without it, startx fails silently ("cannot display").
          displayManager.startx.enable = true;
        };

        # -------- greetd: tuigreet menu (and optional auto-login) --------
        services.greetd = {
          enable = true;
          settings = {
            # After logout (or at boot without auto-login): tuigreet menu.
            # No --xsession-wrapper: each .desktop carries its full Exec.
            default_session = {
              command = builtins.concatStringsSep " " [
                "${pkgs.tuigreet}/bin/tuigreet"
                "--time"
                "--remember"
                "--remember-user-session"
                "--asterisks"
                "--sessions ${customSessions}/share/wayland-sessions:${customSessions}/share/xsessions"
              ];
              user = "greeter";
            };
          }
          // lib.optionalAttrs cfg.autoLogin {
            # At boot: start the X session directly, no login screen.
            initial_session = {
              command = "${boot-xsession}";
              inherit user;
            };
          };
        };

        # -------- Desktop plumbing --------
        services.gnome.gnome-keyring.enable = true;

        # dconf: needed by the Home Manager GTK modules (theme, cursor).
        programs.dconf.enable = true;

        xdg.portal = {
          enable = true;
          config.common.default = "*";
        };

        hardware.graphics = {
          enable = true;
          enable32Bit = true;
        };
      })
    ]
  );
}
